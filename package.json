{
  "name": "mengai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "check:boundaries": "bun tools/check-boundaries.ts",
    "migrate": "bun tools/migrate.ts",
    "bench:tokens": "bun tools/bench-tokens.ts",
    "build:desktop": "bun run --cwd apps/desktop build"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
