# MengAI environment. Copy to .env and fill in real values. Never commit .env.
# Schema and validation: packages/config/src/env.ts
#
# Local first: the public website is a static copy of the UI and stores
# nothing. Each owner runs the crew engine on their own Mac (the MengAI app,
# or `bun run dev`) on 127.0.0.1:4190, and the browser talks straight to it.
# Local mode has no login or token: the Host check, the exact Origin
# allowlist below and JSON-only mutations guard it. Server mode still works
# for self-hosting but the website does not use it.

# ---------------------------------------------------------------- mode
# server = self-hosted web app, local = desktop sidecar (set by the Mac app)
MENGAI_MODE=server

# ---------------------------------------------------------------- listen
HOST=0.0.0.0
PORT=3001
# reverse proxy hops to trust for X-Forwarded-For (0 = socket peer address)
TRUST_PROXY=0

# ---------------------------------------------------------------- storage
# server default: /data (local default: ~/Library/Application Support/MengAI)
DATA_DIR=/data
# parent folder for new project workspaces (default: DATA_DIR/workspaces)
WORKSPACES_DIR=
# built SPA served at / (default: none, API only)
WEB_DIR=
# postgres://user:password@host:5432/db (required in server mode; sqlite://path also works)
DATABASE_URL=
# optional; without it rate limits and caches stay in process memory
REDIS_URL=

# optional S3-compatible blob storage; set all four or none (fallback: DATA_DIR/blobs)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- secrets
# 32 random bytes, base64 (openssl rand -base64 32). Required in server mode.
# Wraps every stored provider key. Back it up; never rotate it in place.
VAULT_KEK=
# one-time code to create the owner account on first run (12+ chars). Remove after setup.
SETUP_CODE=

# ---------------------------------------------------------------- http
# server mode: extra exact origins allowed to call the API with credentials,
# comma separated. Same origin is always allowed. Never "*".
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- local engine
# websites that serve a static copy of the MengAI UI and may call the engine on
# this Mac, comma separated exact https origins (https://host[:port]). Any other
# Origin gets a 403. The engine's own http://127.0.0.1:<port> and
# http://localhost:<port> are always allowed.
MENGAI_SITE_ORIGINS=
# development only: the origin serving the UI when it is not the engine itself,
# one exact loopback origin with a port (for example http://localhost:3000).
MENGAI_UI_ORIGIN=

# ---------------------------------------------------------------- logs
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- docker compose only
# used by infra/docker-compose.yml to build DATABASE_URL and REDIS_URL
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Model API keys are NOT configured here: users add their own provider keys in
# the app (Providers), and they are stored encrypted in the vault.

# Local development only
# MENGAI_DEMO=1 drives runs with the scripted demo crew instead of your providers.
MENGAI_DEMO=0
# MENGAI_DEV_OPEN=1 prints the local URL for a normal browser and keeps serving when stdin closes.
MENGAI_DEV_OPEN=0
