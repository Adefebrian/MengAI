{
  "name": "@mengai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo \"apps/api ships as TypeScript source; desktop sidecar is built by apps/desktop\" && exit 0",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured for apps/api' && exit 0",
    "build:sidecar": "bun build --compile --minify --target=bun-darwin-arm64 src/local.ts --outfile ../desktop/src-tauri/binaries/mengai-api-aarch64-apple-darwin"
  },
  "dependencies": {
    "@mengai/config": "workspace:*",
    "@mengai/shared": "workspace:*",
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.7.0"
  }
}
